#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "C:\Users\Admin\scoop\apps\iverilog\current\lib\ivl\system.vpi";
:vpi_module "C:\Users\Admin\scoop\apps\iverilog\current\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\Users\Admin\scoop\apps\iverilog\current\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\Users\Admin\scoop\apps\iverilog\current\lib\ivl\v2005_math.vpi";
:vpi_module "C:\Users\Admin\scoop\apps\iverilog\current\lib\ivl\va_math.vpi";
S_0000018943650720 .scope module, "tb" "tb" 2 2;
 .timescale -9 -9;
v000001894368E360_0 .var "clk", 0 0;
v000001894368DAA0_0 .net "led", 0 0, v000001894368E180_0;  1 drivers
S_0000018943650960 .scope module, "uut" "top" 2 6, 3 1 0, S_0000018943650720;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /OUTPUT 1 "led";
v000001894368E680_0 .net "clk", 0 0, v000001894368E360_0;  1 drivers
v000001894368E180_0 .var "led", 0 0;
E_000001894368B300 .event posedge, v000001894368E680_0;
    .scope S_0000018943650960;
T_0 ;
    %wait E_000001894368B300;
    %jmp T_0;
    .thread T_0;
    .scope S_0000018943650720;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001894368E360_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v000001894368E360_0;
    %inv;
    %store/vec4 v000001894368E360_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0000018943650720;
T_2 ;
    %vpi_call 2 17 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call 2 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0000018943650720 {0 0 0};
    %vpi_call 2 19 "$monitor", "Time=%0t | clk=%b | led=%b", $time, v000001894368E360_0, v000001894368DAA0_0 {0 0 0};
    %delay 200, 0;
    %vpi_call 2 21 "$finish" {0 0 0};
    %end;
    .thread T_2;
